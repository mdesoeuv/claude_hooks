{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PROJECT_DIR}/.claude/hooks/aws_readonly_guard.py\"",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PROJECT_DIR}/.claude/hooks/iac_readonly_guard.py\"",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PROJECT_DIR}/.claude/hooks/git_safety_guard.py\"",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PROJECT_DIR}/.claude/hooks/secrets_guard.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)"
    ]
  }
}
